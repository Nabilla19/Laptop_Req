// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Laptop {
  id                String   @id @default(cuid())
  laptopId          String?  @unique // ID dari dataset asli (jika ada)
  company           String
  product           String
  typeName          String?
  inches            Float?
  screenResolution  String?
  cpu               String?
  ram               Int      // dalam GB
  memory            String?  // nilai asli
  storageGb         Int      // total kapasitas dalam GB
  storageTypes      String?  // JSON: detail jenis penyimpanan
  gpu               String?
  opSys             String?
  weight            Float    // dalam kg
  priceEuros        Float    // harga asli dalam euro
  cpuScore          Int?     // skor performa CPU (0-100), null = belum dihitung
  cpuScoreMethod    String?  // "benchmark" | "heuristic" | "unknown"
  isDemo            Boolean  @default(false)
  importBatchId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  RecommendationItem RecommendationItem[]

  @@index([company])
  @@index([priceEuros])
  @@index([ram])
  @@index([importBatchId])
}

model Criteria {
  id          String   @id @default(cuid())
  code        String   @unique // C1, C2, C3, C4, C5
  name        String
  weight      Float    // 0.0 - 1.0
  attrType    String   // "benefit" | "cost"
  description String?
  extractRule String?  // catatan aturan ekstraksi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeightPreset {
  id          String   @id @default(cuid())
  name        String   @unique // kuliah_umum, pemrograman, dsb
  label       String
  description String?
  weights     String   // JSON: { C1: 0.3, C2: 0.25, ... }
  createdAt   DateTime @default(now())
}

model RecommendationHistory {
  id              String   @id @default(cuid())
  calculatedAt    DateTime @default(now())
  budgetMax       Float?   // anggaran maksimal dalam euro, null = tidak difilter
  usageType       String?  // kuliah_umum, pemrograman, dsb
  screenPref      String?  // preferensi ukuran layar
  priorityPref    String?  // "ringan" | "performa"
  weightsUsed     String   // JSON snapshot bobot saat perhitungan
  totalAlternatives Int
  presetUsed      String?

  items RecommendationItem[]

  createdAt DateTime @default(now())
}

model RecommendationItem {
  id               String   @id @default(cuid())
  historyId        String
  laptopId         String
  rank             Int
  sawScore         Float
  normalizedMatrix String   // JSON: nilai normalisasi per kriteria
  weightedValues   String   // JSON: nilai bobot x normalisasi per kriteria
  rawValues        String   // JSON: nilai asli per kriteria

  history RecommendationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  laptop  Laptop                @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  @@index([historyId])
  @@index([laptopId])
}

model ImportBatch {
  id          String   @id @default(cuid())
  filename    String
  totalRows   Int
  imported    Int
  failed      Int
  skipped     Int
  failedRows  String?  // JSON: array detail baris gagal
  createdAt   DateTime @default(now())
}
