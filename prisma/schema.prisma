generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Laptop {
  id                 String               @id @default(cuid())
  laptopId           String?              @unique
  company            String
  product            String
  typeName           String?
  inches             Float?
  screenResolution   String?
  cpu                String?
  ram                Int
  memory             String?
  storageGb          Int
  storageTypes       String?
  gpu                String?
  opSys              String?
  weight             Float
  priceEuros         Float
  cpuScore           Int?
  cpuScoreMethod     String?
  isDemo             Boolean              @default(false)
  importBatchId      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  RecommendationItem RecommendationItem[]

  @@index([company])
  @@index([priceEuros])
  @@index([ram])
  @@index([importBatchId])
}

model Criteria {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  weight      Float
  attrType    String
  description String?
  extractRule String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeightPreset {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  weights     String
  createdAt   DateTime @default(now())
}

model RecommendationHistory {
  id                String               @id @default(cuid())
  calculatedAt      DateTime             @default(now())
  budgetMax         Float?
  usageType         String?
  screenPref        String?
  priorityPref      String?
  weightsUsed       String
  totalAlternatives Int
  presetUsed        String?
  createdAt         DateTime             @default(now())
  items             RecommendationItem[]
}

model RecommendationItem {
  id               String                @id @default(cuid())
  historyId        String
  laptopId         String
  rank             Int
  sawScore         Float
  normalizedMatrix String
  weightedValues   String
  rawValues        String
  history          RecommendationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  laptop           Laptop                @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  @@index([historyId])
  @@index([laptopId])
}

model ImportBatch {
  id         String   @id @default(cuid())
  filename   String
  totalRows  Int
  imported   Int
  failed     Int
  skipped    Int
  failedRows String?
  createdAt  DateTime @default(now())
}
